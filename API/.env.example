# Application Identity
PROJECT_NAME=ImageOptimize
VERSION=1.0.0

# API Configuration
API_V1_STR=/api/v1

# Resource Limits
MAX_IMAGE_PIXELS=50000000
MAX_PAYLOAD_SIZE_BYTES=20971520

# Database Configuration
DATABASE_URL=sqlite:///./imageoptimize.db

# Quality Configuration
DEFAULT_QUALITY_LOW=10
DEFAULT_QUALITY_HIGH=95

# Image Processing
VIPS_DLL_PATH=vips\vips-dev-8.15\bin

# Storage Architecture
STORAGE_DIR=./storage
ENABLE_CLEANUP_CRON=True
CLEANUP_RETENTION_MINUTES=60
